# Upstream MCP data source (public server returning synthetic PII/PCI/PHI)
MCP_SERVER_URL=https://mcp.dlptest.com/api/mcp/
MCP_TIMEOUT_MS=20000

# Everything AI-related runs through OpenRouter — one key, no other account
# needed. Leave OPENROUTER_API_KEY blank and the service still works: the
# detection pass falls back to regex-only, and /analyze returns a 400.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LLM_MAX_CHARS=6000
LLM_TIMEOUT_MS=30000

# Step 5 of the pipeline (asking a model about the redacted data). Reuses
# OPENROUTER_API_KEY. Only set ANALYSIS_MODEL if you want a different model
# than the detection pass uses.
ANALYSIS_MODEL=openrouter/free
ANALYSIS_TIMEOUT_MS=30000

# Audit storage. Unset -> in-memory ring buffer, cleared on restart.
MONGODB_URI=
MONGODB_DB=mcpguard

PORT=5000
CORS_ORIGIN=*
